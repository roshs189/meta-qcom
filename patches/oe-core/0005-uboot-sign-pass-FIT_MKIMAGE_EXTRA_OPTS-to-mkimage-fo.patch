From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Viswanath Kraleti <viswanath.kraleti@oss.qualcomm.com>
Date: Fri, 6 Nov 2026 20:19:55 +0530
Subject: [OE-core][PATCH] uboot-sign: pass FIT_MKIMAGE_EXTRA_OPTS to mkimage
 for the U-Boot fitImage

There is no way to pass options such as -E, which places the image
data after the FIT structure, to the mkimage call creating the U-Boot
fitImage. Such an option also has to be repeated when signing, since
mkimage -F moves external data back into the FIT unless -E is given
again.

Pass FIT_MKIMAGE_EXTRA_OPTS, which the kernel FIT image already takes
its extra mkimage options from and which image-fitimage.conf defines,
to the mkimage calls that create and sign the U-Boot fitImage, and
extend the selftest to check that -E is kept through signing.

Assisted-by: Claude Code:claude-opus-5-5
Signed-off-by: Viswanath Kraleti <viswanath.kraleti@oss.qualcomm.com>
Upstream-Status: Pending
---
 meta/classes-recipe/uboot-sign.bbclass   |  3 ++
 meta/conf/image-fitimage.conf            |  5 ++-
 meta/lib/oeqa/selftest/cases/fitimage.py | 42 ++++++++++++++++++++++++
 3 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/meta/classes-recipe/uboot-sign.bbclass b/meta/classes-recipe/uboot-sign.bbclass
index 409f6376b1..409e857ddf 100644
--- a/meta/classes-recipe/uboot-sign.bbclass
+++ b/meta/classes-recipe/uboot-sign.bbclass
@@ -560,6 +560,7 @@ EOF
 	#
 	${UBOOT_MKIMAGE} \
 		${@'-D "${SPL_MKIMAGE_DTCOPTS}"' if len('${SPL_MKIMAGE_DTCOPTS}') else ''} \
+		${FIT_MKIMAGE_EXTRA_OPTS} \
 		-f ${UBOOT_ITS} \
 		${UBOOT_FITIMAGE_BINARY}
 
@@ -588,6 +589,7 @@ EOF
 			cp ${SPL_DIR}/${SPL_DTB_BINARY} ${SPL_DIR}/${SPL_DTB_SIGNED}
 			${UBOOT_MKIMAGE_SIGN} \
 				${@'-D "${SPL_MKIMAGE_DTCOPTS}"' if len('${SPL_MKIMAGE_DTCOPTS}') else ''} \
+				${FIT_MKIMAGE_EXTRA_OPTS} \
 				-F -k "${SPL_SIGN_KEYDIR}" \
 				-K "${SPL_DIR}/${SPL_DTB_SIGNED}" \
 				-r ${UBOOT_FITIMAGE_BINARY} \
@@ -601,6 +603,7 @@ EOF
 			# Sign the U-boot FIT image
 			${UBOOT_MKIMAGE_SIGN} \
 				${@'-D "${SPL_MKIMAGE_DTCOPTS}"' if len('${SPL_MKIMAGE_DTCOPTS}') else ''} \
+				${FIT_MKIMAGE_EXTRA_OPTS} \
 				-F -k "${SPL_SIGN_KEYDIR}" \
 				-r ${UBOOT_FITIMAGE_BINARY} \
 				${SPL_MKIMAGE_SIGN_ARGS}
diff --git a/meta/conf/image-fitimage.conf b/meta/conf/image-fitimage.conf
index a06d30e494..ea8e70d8c5 100644
--- a/meta/conf/image-fitimage.conf
+++ b/meta/conf/image-fitimage.conf
@@ -48,7 +48,10 @@ FIT_OS ?= "linux"
 # DTBs are provided separately in a FIT image.
 FIT_LINUX_BIN ?= "linux.bin"
 
-# Additional mkimage options for FIT image creation
+# Additional mkimage options for FIT image creation. The U-Boot fitImage
+# created by uboot-sign.bbclass also passes them when signing, so that an
+# option such as "-E", which places the image data after the FIT structure,
+# is kept by mkimage -F.
 FIT_MKIMAGE_EXTRA_OPTS ?= ""
 
 # Allow user to select the default DTB for FIT image when multiple dtb's exists.
diff --git a/meta/lib/oeqa/selftest/cases/fitimage.py b/meta/lib/oeqa/selftest/cases/fitimage.py
index 1fad53b16c..7f96f0c942 100644
--- a/meta/lib/oeqa/selftest/cases/fitimage.py
+++ b/meta/lib/oeqa/selftest/cases/fitimage.py
@@ -2133,6 +2133,48 @@ UBOOT_FIT_HASH_ALG = "sha256"
         self._test_fitimage(bb_vars)
 
 
+    def test_sign_uboot_fit_image_extra_opts(self):
+        """
+        Summary:     Check if FIT_MKIMAGE_EXTRA_OPTS is passed to mkimage both
+                     when creating and when signing the U-Boot fitImage.
+        Expected:    1) U-Boot its and FIT image are built and signed
+                        successfully
+                     2) FIT_MKIMAGE_EXTRA_OPTS = "-E" places the image data
+                        after the FIT structure and signing keeps it there:
+                        the image nodes have data-offset instead of data
+        Product:     oe-core
+        Author:      Viswanath Kraleti <viswanath.kraleti@oss.qualcomm.com>
+        """
+        machine = self._get_machine_or_skip()
+        config = """
+# Enable creation and signing of the U-Boot fitImage, with external data
+UBOOT_FITIMAGE_ENABLE = "1"
+SPL_SIGN_ENABLE = "1"
+SPL_SIGN_KEYNAME = "spl-oe-selftest"
+SPL_SIGN_KEYDIR = "${TOPDIR}/signing-keys"
+UBOOT_ENTRYPOINT  = "0x80000000"
+UBOOT_LOADADDRESS = "0x80000000"
+UBOOT_DTB_LOADADDRESS = "0x82000000"
+SPL_MKIMAGE_DTCOPTS = "-I dts -O dtb -p 2000"
+UBOOT_EXTLINUX = "0"
+UBOOT_FIT_GENERATE_KEYS = "1"
+UBOOT_FIT_HASH_ALG = "sha256"
+FIT_MKIMAGE_EXTRA_OPTS = "-E"
+"""
+        config = FitImageTestCase._config_add_machine_settings(config, machine, keys=["UBOOT_MACHINE", "SPL_BINARY", "UBOOT_DTB_BINARY", "UBOOT_ARCH"])
+        config = self._require_machine_capability(config, machine, '_cap_spl_dtb')
+        self.write_config(config)
+        bb_vars = self._fit_get_bb_vars()
+        self._test_fitimage(bb_vars)
+
+        fitimage_path = os.path.join(bb_vars['DEPLOY_DIR_IMAGE'], "u-boot-fitImage-%s" % bb_vars['MACHINE'])
+        dtc_bindir = FitImageTestCase._setup_native('dtc-native')
+        fdtget_path = os.path.join(dtc_bindir, 'fdtget')
+        for node in ('/images/uboot', '/images/fdt'):
+            self._verify_dtb_property(dtc_bindir, fitimage_path, node, 'data', None, absent=True)
+            result = runCmd('%s %s %s data-offset' % (fdtget_path, fitimage_path, node))
+            self.logger.debug("%s data-offset: %s" % (node, result.output))
+
     def test_sign_cascaded_uboot_fit_image(self):
         """
         Summary:     Check if U-Boot FIT image and Image Tree Source (its) are

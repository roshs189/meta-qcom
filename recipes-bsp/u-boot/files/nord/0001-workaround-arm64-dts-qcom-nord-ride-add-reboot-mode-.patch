From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Deepak G <gde@qti.qualcomm.com>
Date: Wed, 30 Sep 2026 08:14:10 +0530
Subject: [PATCH] workaround: arm64: dts: qcom: nord-ride: add reboot-mode
 support

Add the SPMI arbiter and PMIC SDAM nodes needed to reach the
reboot-reason cell, and a nvmem-reboot-mode node so U-Boot can
set it and reboot into the bootloader on request.

The changes need to be pushed to kernel first. So till that
time, adding "workaround" tag for this commit.

Signed-off-by: Deepak G <deepak.g10@oss.qualcomm.com>
Upstream-Status: Backport [https://github.com/qualcomm-linux/u-boot/pull/231]
Signed-off-by: Roshan Sivakumar <roshs@qti.qualcomm.com>
---
 arch/arm/dts/nord-ride-u-boot.dtsi | 101 +++++++++++++++++++++++++++++
 1 file changed, 101 insertions(+)

diff --git a/arch/arm/dts/nord-ride-u-boot.dtsi b/arch/arm/dts/nord-ride-u-boot.dtsi
index 8350444fc20..8a2931fe80d 100644
--- a/arch/arm/dts/nord-ride-u-boot.dtsi
+++ b/arch/arm/dts/nord-ride-u-boot.dtsi
@@ -5,6 +5,8 @@
 
 #include <dt-bindings/clock/qcom,nord-negcc.h>
 #include <dt-bindings/clock/qcom,nord-tcsrcc.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/spmi/spmi.h>
 
 &xo_board_clk {
 	bootph-all;
@@ -15,6 +17,13 @@
 };
 
 / {
+	reboot-mode {
+		compatible = "nvmem-reboot-mode";
+		nvmem-cells = <&reboot_reason>;
+		nvmem-cell-names = "reboot-mode";
+		mode-bootloader = <0x02>;
+	};
+
 	negcc: clock-controller@8900000 {
 		compatible = "qcom,nord-negcc";
 		reg = <0x0 0x08900000 0x0 0xf4200>;
@@ -169,6 +178,98 @@
 	bootph-all;
 };
 
+&soc {
+	/*
+	 * SPMI arbiter base/reg layout confirmed against Nord's actual
+	 * devicetree (dpk_builds/nord/nord.dtsi: spmi@c400000) - this
+	 * replaces the earlier Lemans-cloned address (spmi@c440000),
+	 * which pointed at Nord's "obsrvr" region instead of "core" and
+	 * produced a bogus/aliased peripheral channel map.
+	 */
+	spmi_bus: spmi@c400000 {
+		compatible = "qcom,spmi-pmic-arb";
+		reg = <0x0 0x0c400000 0x0 0x3000>,
+		      <0x0 0x0c500000 0x0 0x400000>,
+		      <0x0 0x0c440000 0x0 0x80000>,
+		      <0x0 0x0c4c0000 0x0 0x10000>,
+		      <0x0 0x0c42d000 0x0 0x4000>;
+		reg-names = "core",
+			    "chnls",
+			    "obsrvr",
+			    "intr",
+			    "cnfg";
+		cell-index = <0>;
+		qcom,channel = <0>;
+		qcom,ee = <0>;
+		qcom,bus-id = <0>;
+		interrupts-extended = <&pdc 1 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "periph_irq";
+		interrupt-controller;
+		#interrupt-cells = <4>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+	};
+};
+
+&spmi_bus {
+	kobra_mm_a: pmic@0 {
+		compatible = "qcom,pmm8654au", "qcom,spmi-pmic";
+		reg = <0x0 SPMI_USID>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		kobra_mm_a_pon: pon@1200 {
+			compatible = "qcom,pmk8350-pon";
+			reg = <0x1200>, <0x800>;
+			reg-names = "hlos", "pbs";
+
+			kobra_mm_a_pon_pwrkey: pwrkey {
+				compatible = "qcom,pmk8350-pwrkey";
+				interrupts-extended = <&spmi_bus 0x0 0x12 0x7 IRQ_TYPE_EDGE_BOTH>;
+				linux,code = <KEY_POWER>;
+				debounce = <15625>;
+			};
+
+			kobra_mm_a_pon_resin: resin {
+				compatible = "qcom,pmk8350-resin";
+				interrupts-extended = <&spmi_bus 0x0 0x12 0x6 IRQ_TYPE_EDGE_BOTH>;
+				debounce = <15625>;
+				status = "disabled";
+			};
+		};
+
+		kobra_mm_a_rtc: rtc@6100 {
+			compatible = "qcom,pmk8350-rtc";
+			reg = <0x6100>, <0x6200>;
+			reg-names = "rtc", "alarm";
+			interrupts-extended = <&spmi_bus 0x0 0x62 0x1 IRQ_TYPE_EDGE_RISING>;
+		};
+
+		kobra_mm_a_gpios: gpio@8800 {
+			compatible = "qcom,pmm8654au-gpio", "qcom,spmi-gpio";
+			reg = <0x8800>;
+			gpio-controller;
+			gpio-ranges = <&kobra_mm_a_gpios 0 0 12>;
+			#gpio-cells = <2>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		kobra_mm_a_sdam_0: nvram@7100 {
+			compatible = "qcom,spmi-sdam";
+			reg = <0x7100>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0 0x7100 0x100>;
+
+			reboot_reason: reboot-reason@48 {
+				reg = <0x48 0x1>;
+				bits = <1 7>;
+			};
+		};
+	};
+};
+
 &ufs_mem_hc {
 	compatible = "qcom,sa8797p-ufshc",
 		     "qcom,sa8255p-ufshc",

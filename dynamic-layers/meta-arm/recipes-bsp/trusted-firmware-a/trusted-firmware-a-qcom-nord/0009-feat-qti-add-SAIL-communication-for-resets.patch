@@ -10,6 +10,7 @@
 #include <bl31/bl31.h>
 #include <common/debug.h>
 #include <drivers/delay_timer.h>
+#include <drivers/qti/sail_comm/sail_comm.h>
 #include <drivers/qti/sec_core/sec_core.h>

+/*
+ * Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Curated clock register definitions for nord.
+ *
+ * Only the registers and fields actually referenced by the nord clock
+ * back-end (clock_init.c) and BSP data (clock_cfg.c) are defined here.
+ * absolute addresses are (SoC base + register offset).
+ *
+ *
+ * Access is via the standard TF-A mmio helpers; the field _BMSK/_SHFT pairs are
+ * used with mmio_clrsetbits_32() for read-modify-write field updates.
+ */
+
+#ifndef CLOCK_HWIO_H
+#define CLOCK_HWIO_H
+
+/*
+ * PLL enable-vote helpers used by the BSP data. Mirror the vendor
+ * PLL_VOTE() macro but expand to curated, per-domain names. Each yields a
+ * { addr, mask } pair for a struct clock_register_mask.
+ */
+#define PLL_VOTE(x) \
+	{ GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE, \
+	  GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE_##x##_BMSK }
+#define NE_PLL_VOTE(x) \
+	{ NE_GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE, \
+	  NE_GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE_##x##_BMSK }
+#define NW_PLL_VOTE(x) \
+	{ NW_GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE, \
+	  NW_GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE_##x##_BMSK }
+#define SE_PLL_VOTE(x) \
+	{ SE_GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE, \
+	  SE_GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE_##x##_BMSK }
+
+/*
+ * Branch (CBCR) enable-vote field-mask helpers used by the BSP data. Mirror
+ * the vendor VOTE()/NE_VOTE()/SE_VOTE() macros but expand to curated,
+ * per-domain names. Each yields a { addr, mask } pair for a struct
+ * clock_register_mask. NW_GCC has no vote-gated clocks in CLOCK_GROUP_INIT,
+ * so no NW_VOTE() is defined.
+ */
+#define VOTE(x) \
+	{ GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE, \
+	  GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_##x##_BMSK }
+#define VOTE_2(x) \
+	{ GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_2, \
+	  GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_2_##x##_BMSK }
+#define VOTE_3(x) \
+	{ GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_3, \
+	  GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_3_##x##_BMSK }
+#define NE_VOTE(x) \
+	{ NE_GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE, \
+	  NE_GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_##x##_BMSK }
+#define NE_VOTE_1(x) \
+	{ NE_GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_1, \
+	  NE_GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_1_##x##_BMSK }
+#define SE_VOTE(x) \
+	{ SE_GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE, \
+	  SE_GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_##x##_BMSK }
+
+/* GCC (main) general */
+#define GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE		0x0019E030U
+#define GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_QUPV3_WRAP3_CORE_CLK_ENA_BMSK	0x800000U
+#define GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_QUPV3_WRAP3_M_CLK_ENA_BMSK	0x400000U
+#define GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_2		0x0019E040U
+#define GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_2_QUPV3_WRAP3_S_AHB_CLK_ENA_BMSK	0x8000U
+#define GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_3		0x0019E048U
+#define GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_3_QSPI_AHB_CLK_ENA_BMSK	0x10000U
+#define GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE_3_QSPI_CORE_CLK_ENA_BMSK	0x20000U
+
+#define GCC_QSPI_AHB_CBCR		0x00156004U
+#define GCC_QSPI_CORE_CBCR	0x00156008U
+#define GCC_QUPV3_WRAP3_CORE_CBCR	0x0012300CU
+#define GCC_QUPV3_WRAP3_M_CBCR	0x00123004U
+#define GCC_QUPV3_WRAP3_S_AHB_CBCR	0x00123008U
+#define GCC_DEBUG_EN		0x00185000U
+#define GCC_DEBUG_EN_CDBGPWRUPREQ_BMSK	0x1U
+#define GCC_DEBUG_EN_CDBGPWRUPREQ_SHFT	0U
+#define GCC_DEBUG_EN_CDBGPWRUPACK_BMSK	0x80000000U
+#define GCC_DEBUG_EN_CDBGPWRUPACK_SHFT	31U
+
+#define GCC_GPLL0_PLL_MODE	0x00100000U
+#define GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE	0x0019E050U
+#define GCC_APCS_TZ_PLL_BRANCH_ENA_VOTE_GCC_GPLL0_BMSK	0x1U
+
+/* NE_GCC general */
+#define NE_GCC_APCS_TZ_CLOCK_BRANCH_ENA_VOTE		0x0895801CU

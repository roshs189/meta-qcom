+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <ac_cfg.h>
+#include <arch_helpers.h>
+#include <common/debug.h>
+#include <lib/utils_def.h>
+#include <xpu4.h>
+#include <xpu4_hal.h>
+#include <xpu_common.h>

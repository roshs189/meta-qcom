From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dinesh Choudhary <idinesh@qti.qualcomm.com>
Date: Sat, 21 Nov 2026 20:18:09 +0530
Subject: [PATCH 14/19] feat(qti): add PSCI SYSTEM_RESET2 support

Platforms using the common QTI PM backend (qti_pm.c) only implement
SYSTEM_RESET and SYSTEM_OFF. Clients that need a vendor-defined reset
sub-type - e.g. flagging the next boot as a specific recovery mode via
a reboot-reason cookie - have no PSCI callback to invoke, since
system_reset2 is left unset in plat_qti_psci_pm_ops.

Add qti_system_reset2(), wired up as .system_reset2, following the
semantics of downstream TZ's psci_system_reset2(): only vendor resets
are accepted (the architectural warm reset is rejected, matching
downstream behavior), and the vendor reset_type selects a PMIC PON
warm or hard reset via qti_pmic_prepare_reset2(). Bit 16 of the vendor
payload optionally stashes a reboot-reason cookie into a PMIC PON
scratch register or a TCSR scratch register, mirroring downstream TZ's
psci_target_system_reset2() ASIC hook.

qti_pm.c is shared by every hoya and bruin platform, so this enables
SYSTEM_RESET2 across the board, but the cookie-stash scratch registers
(PON_SOFT_RB_SPARE, TCSR_BOOT_MISC_DETECT) are only defined for shikra
so far; qti_pmic_prepare_reset2() guards that part behind
#if defined(...) so platforms without them keep building.

Assisted-by: Claude:claude-sonnet-5
Signed-off-by: Dinesh Choudhary <idinesh@qti.qualcomm.com>
Upstream-Status: Submitted [https://github.com/qualcomm-linux/trusted-firmware-a/pull/134]
Signed-off-by: Roshan Sivakumar <roshs@qti.qualcomm.com>
---
 plat/qti/bruin/shikra/inc/shikra_def.h |  5 +++
 plat/qti/common/inc/qti_plat.h         |  1 +
 plat/qti/common/src/pm_ps_hold.c       | 52 +++++++++++++++++++++++++-
 plat/qti/common/src/qti_pm.c           | 25 +++++++++++++
 4 files changed, 82 insertions(+), 1 deletion(-)

diff --git a/plat/qti/bruin/shikra/inc/shikra_def.h b/plat/qti/bruin/shikra/inc/shikra_def.h
index 3c97e6d07..62f9b6b1d 100644
--- a/plat/qti/bruin/shikra/inc/shikra_def.h
+++ b/plat/qti/bruin/shikra/inc/shikra_def.h
@@ -187,6 +187,11 @@
 /*----------------------------------------------------------------------------*/
 #define PON_PS_HOLD_RESET_CTL			0x85A
 #define PON_PS_HOLD_RESET_CTL2			0x85B
+#define PON_SOFT_RB_SPARE			0x88F
+/*----------------------------------------------------------------------------*/
+/* TCSR reboot-reason scratch register (CORE_TOP_CSR_BASE + 0xC0000 + 0x13000) */
+/*----------------------------------------------------------------------------*/
+#define TCSR_BOOT_MISC_DETECT			0x003D3000
 /*----------------------------------------------------------------------------*/
 /* APSS HM registers */
 /*----------------------------------------------------------------------------*/
diff --git a/plat/qti/common/inc/qti_plat.h b/plat/qti/common/inc/qti_plat.h
index a48a06c2c..c74f73909 100644
--- a/plat/qti/common/inc/qti_plat.h
+++ b/plat/qti/common/inc/qti_plat.h
@@ -49,6 +49,7 @@ void gic_set_spi_routing(unsigned int id, unsigned int irm, u_register_t mpidr);
 
 void qti_pmic_prepare_reset(void);
 void qti_pmic_prepare_shutdown(void);
+int qti_pmic_prepare_reset2(uint32_t reset_type, uint64_t cookie);
 
 int plat_qti_pwr_domain_on(u_register_t mpidr, int core_pos);
 void plat_qti_pwr_domain_on_finish(int core_pos, const uint8_t *states);
diff --git a/plat/qti/common/src/pm_ps_hold.c b/plat/qti/common/src/pm_ps_hold.c
index b3f8040a6..96e3add23 100644
--- a/plat/qti/common/src/pm_ps_hold.c
+++ b/plat/qti/common/src/pm_ps_hold.c
@@ -5,6 +5,8 @@
  */
 
 #include <drivers/delay_timer.h>
+#include <lib/mmio.h>
+#include <lib/psci/psci.h>
 
 #include <qti_plat.h>
 #include <spmi_arb.h>
@@ -14,11 +16,26 @@
  * include other part numbers like PM6150.
  */
 
-#define RESET_TYPE_HARD_RESET		7
+#define RESET_TYPE_WARM_RESET		1
 #define RESET_TYPE_SHUTDOWN		4
+#define RESET_TYPE_HARD_RESET		7
 
 #define S2_RESET_EN			BIT(7)
 
+/*
+ * Vendor SYSTEM_RESET2 sub-types, selected by the low bits of the PSCI
+ * reset_type argument. Mirrors the sub-types of downstream TZ's
+ * pm_app_pon_reset_cfg_type enum that shikra's PMIC PON config actually
+ * distinguishes; any other value is rejected as unsupported.
+ */
+#define QTI_PON_CFG_WARM_RESET		0
+#define QTI_PON_CFG_HARD_RESET		1
+
+#define QTI_RESET2_TYPE_MASK		0x7fU
+
+/* Set when the vendor payload carries a reboot-reason cookie update. */
+#define QTI_RESET2_COOKIE		BIT(16)
+
 static void configure_ps_hold(uint32_t reset_type)
 {
 	/* QTI recommends disabling reset for 10 cycles before reconfiguring. */
@@ -39,3 +56,36 @@ void qti_pmic_prepare_shutdown(void)
 {
 	configure_ps_hold(RESET_TYPE_SHUTDOWN);
 }
+
+int qti_pmic_prepare_reset2(uint32_t reset_type, uint64_t cookie)
+{
+	uint32_t vendor_type = reset_type & QTI_RESET2_TYPE_MASK;
+
+#if defined(PON_SOFT_RB_SPARE) && defined(TCSR_BOOT_MISC_DETECT)
+	/*
+	 * Stash the reboot-reason cookie the same way downstream TZ does, so
+	 * bootloader/HLOS reboot-reason detection keeps working: bit 16
+	 * selects a PMIC PON scratch-register write, otherwise the cookie
+	 * goes into the TCSR scratch register. The scratch registers this
+	 * relies on are only defined for targets that need this behavior.
+	 */
+	if ((reset_type & QTI_RESET2_COOKIE) != 0U) {
+		spmi_arb_write8(PON_SOFT_RB_SPARE, (uint8_t)(cookie << 1));
+		mmio_write_32(TCSR_BOOT_MISC_DETECT, 0);
+	} else if (cookie != 0U) {
+		mmio_write_32(TCSR_BOOT_MISC_DETECT, (uint32_t)cookie);
+		spmi_arb_write8(PON_SOFT_RB_SPARE, 0);
+	}
+#endif
+
+	switch (vendor_type) {
+	case QTI_PON_CFG_WARM_RESET:
+		configure_ps_hold(RESET_TYPE_WARM_RESET);
+		return PSCI_E_SUCCESS;
+	case QTI_PON_CFG_HARD_RESET:
+		configure_ps_hold(RESET_TYPE_HARD_RESET);
+		return PSCI_E_SUCCESS;
+	default:
+		return PSCI_E_NOT_SUPPORTED;
+	}
+}
diff --git a/plat/qti/common/src/qti_pm.c b/plat/qti/common/src/qti_pm.c
index 213dde8c9..c6dd93945 100644
--- a/plat/qti/common/src/qti_pm.c
+++ b/plat/qti/common/src/qti_pm.c
@@ -209,6 +209,30 @@ __dead2 void qti_system_reset(void)
 	assert_ps_hold();
 }
 
+/*
+ * qti_system_reset2
+ *
+ * Only vendor-specific reset types are supported, matching downstream TZ's
+ * behavior: the architectural warm reset (is_vendor == 0) is rejected.
+ * On a supported vendor type this does not return - PS_HOLD is deasserted
+ * and the SoC resets.
+ */
+static int qti_system_reset2(int is_vendor, int reset_type, u_register_t cookie)
+{
+	int ret;
+
+	if (!is_vendor) {
+		return PSCI_E_NOT_SUPPORTED;
+	}
+
+	ret = qti_pmic_prepare_reset2((uint32_t)reset_type, (uint64_t)cookie);
+	if (ret != PSCI_E_SUCCESS) {
+		return ret;
+	}
+
+	assert_ps_hold();
+}
+
 void qti_get_sys_suspend_power_state(psci_power_state_t *req_state)
 {
 	int i;
@@ -261,6 +285,7 @@ const plat_psci_ops_t plat_qti_psci_pm_ops = {
 	.pwr_domain_suspend_finish = qti_node_suspend_finish,
 	.system_off = qti_system_off,
 	.system_reset = qti_system_reset,
+	.system_reset2 = qti_system_reset2,
 	.get_node_hw_state = NULL,
 	.translate_power_state_by_mpidr = NULL,
 	.get_sys_suspend_power_state = qti_get_sys_suspend_power_state,

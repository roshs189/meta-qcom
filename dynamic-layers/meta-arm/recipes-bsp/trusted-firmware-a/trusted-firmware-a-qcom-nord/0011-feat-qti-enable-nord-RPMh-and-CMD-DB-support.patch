+/* APSS RSC register layout for LeMans. */
+#define RSC_REG_BASE			(QTI_APSS_HM_BASE + 0x00a00000U)
+#define RSC_TCS_BASE_OFF		0xd10U
+#define RSC_CMD_STRIDE			0x14U
+#define RSC_CMD_BASE_OFF		0xd30U
 
 #endif /* RPMH_TARGET_H */
